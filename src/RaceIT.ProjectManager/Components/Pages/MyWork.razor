@page "/mi-trabajo"
@attribute [Authorize]
@using Microsoft.EntityFrameworkCore
@using RaceIT.ProjectManager.Data
@using RaceIT.ProjectManager.Domain
@inject IDbContextFactory<ProjectManagerDbContext> Factory
@inject WorkAccess Access

<PageTitle>Mi trabajo | RaceIT</PageTitle>
<h1>Mi trabajo</h1>
@if (error is not null) { <p role="alert">@error</p> }
@if (admin) { <p><a href="/administracion">Administrar todos los proyectos</a></p> }
else
{
    <section class="panel"><h2>Proyectos asignados</h2>
    @foreach (var project in projects) { <p><strong>@project.Name</strong> · @project.WorkCalendar.Name</p> }
    @if (projects.Count == 0) { <p>Sin proyectos asignados.</p> }
    </section>
    <section class="panel"><h2>Actividades asignadas</h2>
    @foreach (var activity in activities)
    {
        <p><strong>@activity.Name</strong> · @activity.Project.Name · @Status(activity.Status) · @activity.EstimatedStart.ToString("dd/MM/yyyy") → @activity.EstimatedFinish.ToString("dd/MM/yyyy")
        <button class="secondary" @onclick="() => editing = activity.Id">Actualizar</button></p>
    }
    @if (activities.Count == 0) { <p>Sin actividades asignadas.</p> }
    </section>
    <section class="panel"><h2>Dependencias directas</h2>
    @foreach (var activity in related)
    {
        <p><strong>@activity.Name</strong> · @(activity.Responsible?.Name ?? "Sin asignar") · @Status(activity.Status) · @activity.EstimatedStart.ToString("dd/MM/yyyy") → @activity.EstimatedFinish.ToString("dd/MM/yyyy")</p>
        @foreach (var blocker in blockers.Where(x => x.ActivityId == activity.Id)) { <p>Bloqueo: @blocker.Description</p> }
    }
    @if (related.Count == 0) { <p>Sin dependencias directas con otras personas.</p> }
    </section>
}
@if (editing is int id) { <ActivityEditModal Id="id" OnClose="Closed" @key="id" /> }

@code {
    private bool admin;
    private int? editing;
    private string? error;
    private List<Project> projects = [];
    private List<ProjectActivity> activities = [], related = [];
    private List<Blocker> blockers = [];
    private static string Status(ActivityStatus value) => value switch { ActivityStatus.Pending => "Pendiente", ActivityStatus.InProgress => "En curso", _ => "Completada" };
    protected override async Task OnInitializedAsync() => await Load();
    private async Task Closed(bool saved) { editing = null; if (saved) await Load(); }
    private async Task Load()
    {
        try {
            await Access.RequireAsync(WorkPermission.ReadOwnWork);
            admin = await Access.IsAdminAsync();
            if (admin) return;
            var person = await Access.PersonIdAsync();
            if (person is null) throw new ArgumentException("Selecciona un usuario válido.");
            await using var db = await Factory.CreateDbContextAsync();
            projects = await db.Projects.AsNoTracking().Include(x => x.WorkCalendar).Where(x => x.ResponsibleId == person).OrderBy(x => x.Name).ToListAsync();
            activities = await db.Activities.AsNoTracking().Include(x => x.Project).Where(x => x.ResponsibleId == person).OrderBy(x => x.EstimatedFinish).ToListAsync();
            var ids = activities.Select(x => x.Id).ToList();
            var links = await db.ActivityDependencies.AsNoTracking().Where(x => ids.Contains(x.PredecessorId) || ids.Contains(x.SuccessorId)).ToListAsync();
            var direct = links.SelectMany(x => new[] { x.PredecessorId, x.SuccessorId }).Except(ids).ToList();
            related = await db.Activities.AsNoTracking().Include(x => x.Responsible).Where(x => direct.Contains(x.Id)).ToListAsync();
            blockers = await db.Blockers.AsNoTracking().Where(x => direct.Contains(x.ActivityId) && x.ResolvedAt == null).ToListAsync();
        }
        catch (Exception) { error = "No se pudo cargar tu trabajo. Comprueba la conexión y vuelve a seleccionar el usuario."; }
    }
}
