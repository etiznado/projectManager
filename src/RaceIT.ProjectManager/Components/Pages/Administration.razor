@page "/administracion"
@attribute [Authorize(Roles = "Administrador")]
@inject PersonService People
@inject ProjectService Projects
@inject ActivityService Activities
@inject TemplateService Templates

<PageTitle>Administración | RaceIT</PageTitle>
<h1>Administración</h1>
@if (error is not null) { <p role="alert">@error</p> }

<section class="panel">
    <h2>Personas</h2>
    <ul>
    @foreach (var person in people)
    {
        <li>@person.Name · @(person.Role == PersonRole.Admin ? "Administrador" : "Usuario") · @person.WeeklyCapacityHours.ToString("0.##") h/sem</li>
    }
    </ul>
    <h3>Nueva persona</h3>
    <EditForm Model="personInput" OnValidSubmit="CreatePerson" FormName="person">
        <DataAnnotationsValidator /><ValidationSummary />
        <label>Nombre<InputText @bind-Value="personInput.Name" /></label>
        <label>Correo<InputText @bind-Value="personInput.Email" /></label>
        <label>Rol
            <InputSelect @bind-Value="personInput.Role">
                <option value="@PersonRole.User">Usuario</option>
                <option value="@PersonRole.Admin">Administrador</option>
            </InputSelect>
        </label>
        <label>Forma de planear
            <InputSelect @bind-Value="personInput.PlanningMode">
                <option value="@PlanningMode.Weekly">Semanal</option>
                <option value="@PlanningMode.ByDeliverables">Por entregas</option>
            </InputSelect>
        </label>
        <label>Bolsa semanal (horas)<InputNumber @bind-Value="personInput.WeeklyCapacityHours" step="0.5" /></label>
        <button type="submit">Crear persona</button>
    </EditForm>
</section>

<section class="panel">
    <h2>Iniciativas</h2>
    <ul>
    @foreach (var initiative in initiatives)
    {
        <li>@initiative.Name @if (initiative.TargetDate is DateOnly d) { <span class="muted">· Meta @d.ToString("dd/MM/yyyy")</span> }</li>
    }
    </ul>
    <h3>Nueva iniciativa</h3>
    <EditForm Model="initiativeInput" OnValidSubmit="CreateInitiative" FormName="initiative">
        <DataAnnotationsValidator /><ValidationSummary />
        <label>Nombre<InputText @bind-Value="initiativeInput.Name" /></label>
        <label>Descripción<InputTextArea @bind-Value="initiativeInput.Description" /></label>
        <label>Fecha meta (opcional)<InputDate @bind-Value="initiativeInput.TargetDate" /></label>
        <button type="submit">Crear iniciativa</button>
    </EditForm>
</section>

<section class="panel">
    <h2>Proyectos</h2>
    <ul>
    @foreach (var project in projects)
    {
        <li>@project.Name <span class="muted">· @(project.Initiative?.Name ?? "Sin iniciativa") · @(project.Person?.Name ?? "Sin responsable")</span></li>
    }
    </ul>
    <h3>Nuevo proyecto</h3>
    <EditForm Model="projectInput" OnValidSubmit="CreateProject" FormName="project">
        <DataAnnotationsValidator /><ValidationSummary />
        <label>Nombre<InputText @bind-Value="projectInput.Name" /></label>
        <label>Iniciativa (opcional)
            <select @bind="projectInput.InitiativeId">
                <option value="">Sin iniciativa</option>
                @foreach (var initiative in initiatives) { <option value="@initiative.Id">@initiative.Name</option> }
            </select>
        </label>
        <label>Responsable (opcional)
            <select @bind="projectInput.PersonId">
                <option value="">Sin responsable</option>
                @foreach (var person in people) { <option value="@person.Id">@person.Name</option> }
            </select>
        </label>
        <label>Fecha meta (opcional)<InputDate @bind-Value="projectInput.TargetDate" /></label>
        <button type="submit">Crear proyecto</button>
    </EditForm>
</section>

<section class="panel">
    <h2>Actividades</h2>
    @if (rows.Count == 0) { <p class="muted">Sin actividades.</p> }
    else
    {
        <table>
            <thead><tr><th>Título</th><th>Proyecto</th><th>Responsable</th><th>Estimación</th><th>Pendiente</th><th>Estado</th></tr></thead>
            <tbody>
            @foreach (var row in rows)
            {
                <tr>
                    <td>@row.Activity.Title</td>
                    <td>@(row.Activity.Project?.Name ?? "Sin proyecto")</td>
                    <td>@(row.Activity.Person?.Name ?? "Sin responsable")</td>
                    <td>@row.Activity.CurrentEstimateHours.ToString("0.##") h</td>
                    <td>@row.RemainingHours.ToString("0.##") h @if (row.NeedsReestimate) { <span class="badge risk">Revisar estimación</span> }</td>
                    <td>@Status(row.Activity.Status)</td>
                </tr>
            }
            </tbody>
        </table>
    }
    <h3>Nueva actividad</h3>
    <EditForm Model="activityInput" OnValidSubmit="CreateActivity" FormName="activity">
        <DataAnnotationsValidator /><ValidationSummary />
        <label>Título<InputText @bind-Value="activityInput.Title" /></label>
        <label>Proyecto (opcional)
            <select @bind="activityInput.ProjectId">
                <option value="">Sin proyecto (tarea suelta)</option>
                @foreach (var project in projects) { <option value="@project.Id">@project.Name</option> }
            </select>
        </label>
        <label>Responsable (opcional)
            <select @bind="activityInput.PersonId">
                <option value="">Sin responsable</option>
                @foreach (var person in people) { <option value="@person.Id">@person.Name</option> }
            </select>
        </label>
        <label>Estimación total (horas)<InputNumber @bind-Value="activityInput.CurrentEstimateHours" step="0.25" /></label>
        <fieldset>
            <legend>Predecesoras (dependencias)</legend>
            @if (allActivities.Count == 0) { <p class="muted">Sin actividades para enlazar.</p> }
            @foreach (var activity in allActivities)
            {
                <label class="check"><input type="checkbox" checked="@selectedPredecessors.Contains(activity.Id)" @onchange="args => TogglePredecessor(activity.Id, args)" /> @activity.Title</label>
            }
        </fieldset>
        <button type="submit">Crear actividad</button>
    </EditForm>
</section>

<section class="panel">
    <h2>Plantillas de carreras</h2>
    @foreach (var template in templates)
    {
        <div class="pool-card">
            <strong>@template.Name</strong> <span class="muted">· @CategoryName(template.Category)</span>
            <ul>
            @foreach (var item in template.Items)
            {
                <li>@item.Title · @item.EstimatedHours.ToString("0.##") h</li>
            }
            </ul>
            <button class="secondary" @onclick="() => DeleteTemplateAsync(template.Id)">Eliminar</button>
        </div>
    }
    <h3>Nueva plantilla</h3>
    <EditForm Model="templateInput" OnValidSubmit="CreateTemplateAsync" FormName="template">
        <DataAnnotationsValidator /><ValidationSummary />
        <label>Nombre<InputText @bind-Value="templateInput.Name" /></label>
        <label>Categoría
            <InputSelect @bind-Value="templateInput.Category">
                <option value="@TemplateCategory.Before">Antes</option>
                <option value="@TemplateCategory.During">Durante</option>
                <option value="@TemplateCategory.After">Después</option>
            </InputSelect>
        </label>
        <label>Elementos (una línea por elemento: título,horas)<InputTextArea @bind-Value="templateItemsText" /></label>
        <button type="submit">Crear plantilla</button>
    </EditForm>
</section>

@code {
    private List<Person> people = [];
    private List<Initiative> initiatives = [];
    private List<Project> projects = [];
    private List<Activity> allActivities = [];
    private List<ActivityService.ActivityRow> rows = [];
    private readonly PersonInput personInput = new();
    private readonly InitiativeInput initiativeInput = new();
    private readonly ProjectInput projectInput = new();
    private readonly ActivityInput activityInput = new();
    private HashSet<int> selectedPredecessors = [];
    private List<Template> templates = [];
    private readonly TemplateInput templateInput = new();
    private string templateItemsText = "";
    private string? error;

    protected override async Task OnInitializedAsync() => await Load();

    private async Task Load()
    {
        try
        {
            people = await People.ListActiveAsync();
            initiatives = await Projects.ListInitiativesAsync();
            projects = await Projects.ListProjectsAsync();
            allActivities = await Activities.ListAsync();
            rows = await Activities.ListRowsAsync();
            templates = await Templates.ListAsync();
        }
        catch (Exception ex) { error = ex.Message; }
    }

    private async Task CreatePerson()
    {
        try { await People.CreateAsync(personInput); await Load(); }
        catch (Exception ex) { error = ex.Message; }
    }

    private async Task CreateInitiative()
    {
        try { await Projects.CreateInitiativeAsync(initiativeInput); await Load(); }
        catch (Exception ex) { error = ex.Message; }
    }

    private async Task CreateProject()
    {
        try { await Projects.CreateProjectAsync(projectInput); await Load(); }
        catch (Exception ex) { error = ex.Message; }
    }

    private async Task CreateActivity()
    {
        activityInput.PredecessorIds = selectedPredecessors.ToList();
        try { await Activities.CreateAsync(activityInput); selectedPredecessors = []; await Load(); }
        catch (Exception ex) { error = ex.Message; }
    }

    private void TogglePredecessor(int id, ChangeEventArgs args)
    {
        if (args.Value is bool isChecked && isChecked) selectedPredecessors.Add(id);
        else selectedPredecessors.Remove(id);
    }

    private async Task CreateTemplateAsync()
    {
        templateInput.Items = templateItemsText
            .Split('\n', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries)
            .Select(line => line.Split(',', 2))
            .Select(parts => new TemplateItemInput
            {
                Title = parts[0].Trim(),
                EstimatedHours = parts.Length > 1 && decimal.TryParse(parts[1].Trim(), out var h) ? h : 0
            })
            .Where(x => !string.IsNullOrWhiteSpace(x.Title) && x.EstimatedHours > 0)
            .ToList();
        try { await Templates.CreateAsync(templateInput); templateInput.Items = []; templateItemsText = ""; await Load(); }
        catch (Exception ex) { error = ex.Message; }
    }

    private async Task DeleteTemplateAsync(int id)
    {
        try { await Templates.DeleteAsync(id); await Load(); }
        catch (Exception ex) { error = ex.Message; }
    }

    private static string CategoryName(TemplateCategory category) => category switch
    {
        TemplateCategory.Before => "Antes",
        TemplateCategory.During => "Durante",
        _ => "Después"
    };

    private static string Status(ActivityStatus status) => status switch
    {
        ActivityStatus.Pending => "Pendiente",
        ActivityStatus.InProgress => "En curso",
        _ => "Completada"
    };
}

