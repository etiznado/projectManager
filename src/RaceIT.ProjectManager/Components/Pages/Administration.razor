@page "/administracion"
@attribute [Authorize(Roles = "Administrador")]
@inject PersonService People
@inject ProjectService Projects
@inject ActivityService Activities
@inject TemplateService Templates

<PageTitle>Administración | RaceIT</PageTitle>
<h1>Administración</h1>
<nav class="admin-sections" aria-label="Secciones de administración">
    <button type="button" class="@(section == AdminSection.People ? "selected" : "secondary")" aria-pressed="@(section == AdminSection.People)" @onclick="() => SelectSection(AdminSection.People)">Personas</button>
    <button type="button" class="@(section == AdminSection.Initiatives ? "selected" : "secondary")" aria-pressed="@(section == AdminSection.Initiatives)" @onclick="() => SelectSection(AdminSection.Initiatives)">Iniciativas</button>
    <button type="button" class="@(section == AdminSection.Projects ? "selected" : "secondary")" aria-pressed="@(section == AdminSection.Projects)" @onclick="() => SelectSection(AdminSection.Projects)">Proyectos</button>
    <button type="button" class="@(section == AdminSection.Activities ? "selected" : "secondary")" aria-pressed="@(section == AdminSection.Activities)" @onclick="() => SelectSection(AdminSection.Activities)">Actividades</button>
    <button type="button" class="@(section == AdminSection.Templates ? "selected" : "secondary")" aria-pressed="@(section == AdminSection.Templates)" @onclick="() => SelectSection(AdminSection.Templates)">Plantillas</button>
</nav>
@if (error is not null) { <p role="alert">@error</p> }

@if (section == AdminSection.People)
{
<section class="panel">
    <h2>Personas</h2>
    <h3 tabindex="-1" @ref="formHeading">@(editingPerson is null ? "Nueva persona" : $"Editar persona: {editingPerson.Name}")</h3>
    <PersonForm @key="editingPerson?.Id ?? 0" ExistingPerson="editingPerson" OnSaved="OnPersonSavedAsync" OnCancel="CancelPersonEdit" />
    <h3>Personas registradas</h3>
    <ul>
    @foreach (var person in people)
    {
        <li>@person.Name · @(person.Role == PersonRole.Admin ? "Administrador" : "Usuario") · @person.WeeklyCapacityHours.ToString("0.##") h/sem <button type="button" class="secondary project-edit" @onclick="() => EditPerson(person)">Editar</button></li>
    }
    </ul>
</section>
}

@if (section == AdminSection.Initiatives)
{
<section class="panel">
    <h2>Iniciativas</h2>
    <h3 tabindex="-1" @ref="formHeading">@(editingInitiative is null ? "Nueva iniciativa" : $"Editar iniciativa: {editingInitiative.Name}")</h3>
    <InitiativeForm @key="editingInitiative?.Id ?? 0" ExistingInitiative="editingInitiative" OnSaved="OnInitiativeSavedAsync" OnCancel="CancelInitiativeEdit" />
    <h3>Iniciativas registradas</h3>
    <ul>
    @foreach (var initiative in initiatives)
    {
        <li>@initiative.Name @if (initiative.TargetDate is DateOnly d) { <span class="muted">· Meta @d.ToString("dd/MM/yyyy")</span> } <button type="button" class="secondary project-edit" @onclick="() => EditInitiative(initiative)">Editar</button></li>
    }
    </ul>
</section>
}

@if (section == AdminSection.Projects)
{
<section class="panel">
    <h2>Proyectos</h2>
    <h3 tabindex="-1" @ref="formHeading">@(editingProject is null ? "Nuevo proyecto" : $"Editar proyecto: {editingProject.Name}")</h3>
    <ProjectForm @key="editingProject?.Id ?? 0" ExistingProject="editingProject" Initiatives="initiatives" OnCreated="OnProjectSavedAsync" OnSaved="OnProjectSavedAsync" OnCancel="CancelProjectEdit" />
    <h3>Proyectos registrados</h3>
    <ul>
    @foreach (var project in projects)
    {
        <li>@project.Name <span class="muted">· @(project.Initiative?.Name ?? "Sin iniciativa") · @(project.Person?.Name ?? "Sin responsable")</span> <button type="button" class="secondary project-edit" @onclick="() => EditProject(project)">Editar</button></li>
    }
    </ul>
</section>
}

@if (section == AdminSection.Activities)
{
<section class="panel">
    <h2>Actividades</h2>
    <h3 tabindex="-1" @ref="formHeading">@(editingActivity is null ? "Nueva actividad" : $"Editar actividad: {editingActivity.Title}")</h3>
    <ActivityForm @key="editingActivity?.Id ?? 0" ExistingActivity="editingActivity" OnCreated="OnActivitySavedAsync" OnSaved="OnActivitySavedAsync" OnCancel="CancelActivityEdit" />
    <h3>Actividades registradas</h3>
    @if (rows.Count == 0) { <p class="muted">Sin actividades.</p> }
    else
    {
        <table>
            <thead><tr><th>Título</th><th>Proyecto</th><th>Responsable</th><th>Estimación</th><th>Pendiente</th><th>Estado</th><th></th></tr></thead>
            <tbody>
            @foreach (var row in rows)
            {
                <tr>
                    <td>@row.Activity.Title</td>
                    <td>@(row.Activity.Project?.Name ?? "Sin proyecto")</td>
                    <td>@(row.Activity.Person?.Name ?? "Sin responsable")</td>
                    <td>@row.Activity.CurrentEstimateHours.ToString("0.##") h</td>
                    <td>@row.RemainingHours.ToString("0.##") h @if (row.NeedsReestimate) { <span class="badge risk">Revisar estimación</span> }</td>
                    <td>@Status(row.Activity.Status)</td>
                    <td><button type="button" class="secondary project-edit" @onclick="() => EditActivity(row.Activity)">Editar</button></td>
                </tr>
            }
            </tbody>
        </table>
    }
</section>
}

@if (section == AdminSection.Templates)
{
<section class="panel">
    <h2>Plantillas de carreras</h2>
    <h3 tabindex="-1" @ref="formHeading">@(SelectedTemplate is null ? "Nueva plantilla" : $"Editar plantilla: {SelectedTemplate.Name}")</h3>
    <TemplateForm @key="selectedTemplateId" ExistingTemplate="SelectedTemplate" OnSaved="OnTemplateSavedAsync" OnCancel="CancelTemplateEdit" />
    <h3>Plantillas registradas</h3>
    @if (templates.Count == 0) { <p class="muted">Sin plantillas.</p> }
    else
    {
        <ul>
        @foreach (var template in templates)
        {
            <li>
                @template.Name <span class="muted">· @CategoryName(template.Category) · @template.Items.Count elementos</span>
                <button type="button" class="secondary project-edit" @onclick="() => EditTemplate(template)">Editar</button>
                <button type="button" class="secondary project-edit" @onclick="() => RequestDeleteTemplate(template)">Eliminar</button>
            </li>
        }
        </ul>
    }
</section>
}

@if (templateToDelete is not null)
{
    <div class="modal-backdrop" tabindex="-1" @ref="deleteTemplateModal" @onkeydown="OnDeleteTemplateKeyDown" @onclick="CancelDeleteTemplate">
        <section class="modal" role="alertdialog" aria-modal="true" aria-labelledby="delete-template-title" aria-describedby="delete-template-description" @onclick:stopPropagation>
            <div class="modal-head">
                <h2 id="delete-template-title">Eliminar plantilla</h2>
            </div>
            <div class="modal-body">
                <p id="delete-template-description">¿Eliminar la plantilla <strong>@templateToDelete.Name</strong>? Se quitarán sus elementos. Las actividades ya creadas permanecerán.</p>
                @if (deleteTemplateError is not null) { <p role="alert">@deleteTemplateError</p> }
                <div class="form-actions">
                    <button type="button" class="secondary" disabled="@deletingTemplate" @onclick="CancelDeleteTemplate">Cancelar</button>
                    <button type="button" class="danger" disabled="@deletingTemplate" @onclick="ConfirmDeleteTemplateAsync">@(deletingTemplate ? "Eliminando…" : "Sí, eliminar")</button>
                </div>
            </div>
        </section>
    </div>
}

@code {
    private enum AdminSection { People, Initiatives, Projects, Activities, Templates }
    private AdminSection section = AdminSection.Projects;
    private List<Person> people = [];
    private Person? editingPerson;
    private List<Initiative> initiatives = [];
    private Initiative? editingInitiative;
    private List<Project> projects = [];
    private Project? editingProject;
    private List<ActivityService.ActivityRow> rows = [];
    private Activity? editingActivity;
    private List<Template> templates = [];
    private int selectedTemplateId;
    private Template? SelectedTemplate => templates.FirstOrDefault(x => x.Id == selectedTemplateId);
    private Template? templateToDelete;
    private string? deleteTemplateError;
    private bool deletingTemplate;
    private bool focusDeleteTemplateModal;
    private ElementReference deleteTemplateModal;
    private bool focusFormHeading;
    private ElementReference formHeading;
    private string? error;

    private void SelectSection(AdminSection selected)
    {
        section = selected;
        error = null;
        editingPerson = null;
        editingInitiative = null;
        editingProject = null;
        editingActivity = null;
        selectedTemplateId = 0;
        CancelDeleteTemplate();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (focusDeleteTemplateModal)
        {
            focusDeleteTemplateModal = false;
            try { await deleteTemplateModal.FocusAsync(); }
            catch { /* el modal aún no está en el DOM */ }
        }
        if (focusFormHeading)
        {
            focusFormHeading = false;
            try { await formHeading.FocusAsync(); }
            catch { /* el formulario aún no está en el DOM */ }
        }
    }

    protected override async Task OnInitializedAsync() => await Load();

    private async Task Load()
    {
        try
        {
            error = null;
            people = await People.ListActiveAsync();
            initiatives = await Projects.ListInitiativesAsync();
            projects = await Projects.ListProjectsAsync();
            rows = await Activities.ListRowsAsync();
            templates = await Templates.ListAsync();
        }
        catch (Exception ex) { error = ex.Message; }
    }

    private void EditPerson(Person person) { editingPerson = person; focusFormHeading = true; }
    private void CancelPersonEdit() => editingPerson = null;
    private async Task OnPersonSavedAsync(Person _) { editingPerson = null; await Load(); }

    private void EditInitiative(Initiative initiative) { editingInitiative = initiative; focusFormHeading = true; }
    private void CancelInitiativeEdit() => editingInitiative = null;
    private async Task OnInitiativeSavedAsync(Initiative _) { editingInitiative = null; await Load(); }

    private void EditProject(Project project) { editingProject = project; focusFormHeading = true; }
    private void CancelProjectEdit() => editingProject = null;

    private async Task OnProjectSavedAsync(Project _)
    {
        editingProject = null;
        await Load();
    }

    private void EditActivity(Activity activity) { editingActivity = activity; focusFormHeading = true; }
    private void CancelActivityEdit() => editingActivity = null;
    private async Task OnActivitySavedAsync(Activity _) { editingActivity = null; await Load(); }

    private void EditTemplate(Template template) { selectedTemplateId = template.Id; focusFormHeading = true; }
    private void CancelTemplateEdit() => selectedTemplateId = 0;
    private async Task OnTemplateSavedAsync(Template _) { selectedTemplateId = 0; await Load(); }

    private void RequestDeleteTemplate(Template template)
    {
        templateToDelete = template;
        deleteTemplateError = null;
        focusDeleteTemplateModal = true;
    }

    private void CancelDeleteTemplate()
    {
        if (deletingTemplate) return;
        templateToDelete = null;
        deleteTemplateError = null;
    }

    private void OnDeleteTemplateKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Escape") CancelDeleteTemplate();
    }

    private async Task ConfirmDeleteTemplateAsync()
    {
        if (deletingTemplate || templateToDelete is null) return;
        deletingTemplate = true;
        deleteTemplateError = null;
        try
        {
            await Templates.DeleteAsync(templateToDelete.Id);
            templateToDelete = null;
            selectedTemplateId = 0;
            await Load();
        }
        catch (Exception ex) { deleteTemplateError = ex.Message; }
        finally { deletingTemplate = false; }
    }

    private static string CategoryName(TemplateCategory category) => category switch
    {
        TemplateCategory.Before => "Antes",
        TemplateCategory.During => "Durante",
        _ => "Después"
    };

    private static string Status(ActivityStatus status) => status switch
    {
        ActivityStatus.Pending => "Pendiente",
        ActivityStatus.InProgress => "En curso",
        _ => "Completada"
    };
}

