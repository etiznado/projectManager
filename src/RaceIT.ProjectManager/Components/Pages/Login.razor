@page "/login"
@attribute [AllowAnonymous]
@inject PersonService PersonService

<PageTitle>Seleccionar usuario | RaceIT</PageTitle>
<section class="panel">
    <h1>Seleccionar usuario</h1>
    <p class="muted">Acceso provisional sin contraseña para desarrollo local.</p>
    @if (error is not null) { <p role="alert">@error</p> }
    <form method="post" action="/session/login" data-enhance="false">
        <AntiforgeryToken />
        <label>Usuario
            <select name="user" required>
                <option value="">Selecciona un usuario</option>
                @foreach (var person in people)
                {
                    <option value="@person.Id">@person.Name · @(person.Role == PersonRole.Admin ? "Administrador" : "Usuario") (#@person.Id)</option>
                }
            </select>
        </label>
        <button type="submit">Entrar</button>
    </form>
</section>

@code {
    private List<Person> people = [];
    private string? error;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            people = await PersonService.ListForLoginAsync();
        }
        catch (Exception)
        {
            error = "No se pudo cargar la lista de usuarios. Comprueba la conexión.";
        }
    }
}
