@attribute [Authorize(Roles = "Administrador")]
@page "/tv/{Id:int}"
@using System.Globalization
@using RaceIT.ProjectManager.Domain
@using RaceIT.ProjectManager.Services
@using RaceIT.ProjectManager.Components.Shared
@implements IAsyncDisposable
@inject TvDashboardService Service
@inject ILogger<Tv> Logger
@inject IJSRuntime JS

<PageTitle>@(data?.Initiative.Name ?? "Dashboard") | RaceIT TV</PageTitle>
<div class="tv-screen">
@if (data is null)
{
    <main class="tv-empty"><span class="tv-eyebrow">RACEIT · PROJECT MANAGER</span><h1>@(loading ? "Cargando iniciativa…" : "Dashboard no disponible")</h1><p>@error</p><a href="/administracion">Volver a administración</a></main>
}
else
{
    var health = data.Health(today);
    var pendingMilestones = data.Milestones.Where(x => !x.ActualDate.HasValue).OrderBy(x => x.EstimatedDate).ThenBy(x => x.Id).ToList();
    var milestonePages = Math.Max(1, (pendingMilestones.Count + 1) / 2);
    var blockerPages = Math.Max(1, (data.Blockers.Count + 1) / 2);
    <header class="tv-header"><div><span class="tv-eyebrow">RACEIT · INICIATIVA</span><h1>@data.Initiative.Name</h1></div><div class="tv-header-right"><strong>@today.ToString("dd MMM yyyy", Spanish).ToUpperInvariant()</strong><div class="tv-controls"><a href="/administracion">Administración</a><button type="button" @onclick="Fullscreen">Pantalla completa ⛶</button></div></div></header>
    <section class="tv-metrics" aria-label="Resumen de entrega">
        <div><span>Entrega objetivo</span><strong>@data.Initiative.TargetDate.ToString("dd MMM", Spanish).ToUpperInvariant()</strong></div>
        <div><span>@(data.Complete ? "Entrega real" : "Entrega estimada")</span><strong>@(data.Forecast?.ToString("dd MMM", Spanish).ToUpperInvariant() ?? "—") <small class="@(data.Forecast > data.Initiative.TargetDate ? "tv-late" : "tv-teal")">@Deviation</small></strong></div>
        <div><span>Estado general</span><strong class="tv-health @HealthClass(health)">@health</strong><small>@data.Activities.Count(x => x.Status == ActivityStatus.Completed) / @data.Activities.Count actividades · @data.Blockers.Count bloqueos</small></div>
    </section>
    @if (error is not null) { <div class="tv-stale" role="alert">@error · Última actualización correcta: @data.UpdatedAt.ToString("HH:mm:ss")</div> }
    <main class="tv-main">
        <section class="tv-chart-panel">
        @if (data.Projects.Count == 0) { <div class="tv-empty-chart">Agrega proyectos y actividades desde administración.</div> }
        else { <TvTimelineChart Data="data" Page="page" Today="today" /> }
        </section>
        <aside class="tv-sidebar">
            <section class="tv-card"><h2>Próximos milestones</h2>
            @if (pendingMilestones.Count == 0) { <p class="tv-muted">@(data.Milestones.Count == 0 ? "No hay milestones definidos." : "Todos confirmados ✓")</p> }
            @foreach (var item in pendingMilestones.Skip((rotation % milestonePages) * 2).Take(2))
            {
                <article class="tv-milestone"><span class="tv-diamond">◆</span><div><strong>@item.Name</strong><small>@item.Project.Name</small><p>@item.EstimatedDate.ToString("dd MMM", Spanish).ToUpperInvariant() <span class="tv-muted">/ objetivo @item.TargetDate.ToString("dd MMM", Spanish)</span></p></div></article>
            }
            @if (milestonePages > 1) { <small class="tv-muted">Página @(rotation % milestonePages + 1) / @milestonePages</small> }
            </section>
            <section class="tv-card tv-blocker-card"><h2>Bloqueos abiertos <span>@data.Blockers.Count</span></h2>
            @if (data.Blockers.Count == 0) { <p class="tv-teal">Sin bloqueos abiertos ✓</p> }
            @foreach (var item in data.Blockers.Skip((rotation % blockerPages) * 2).Take(2))
            {
                <article class="tv-blocker"><strong>@item.Activity.Project.Name · @item.Activity.Name</strong><p>@item.Description</p><small>@(item.Responsible?.Name ?? "Sin responsable asignado")</small></article>
            }
            @if (blockerPages > 1) { <small class="tv-muted">Página @(rotation % blockerPages + 1) / @blockerPages</small> }
            </section>
        </aside>
    </main>
    <footer class="tv-footer"><div class="tv-legend"><span><i style="background:#26d2b5"></i>Completada</span><span><i style="background:#31aaff"></i>En curso</span><span><i style="background:#ffc24d"></i>En riesgo</span><span><i style="background:#ff747b"></i>Atrasada</span><span><i style="background:#7c95b5"></i>Pendiente</span><span>┄ Plan original</span><span>◆ Milestone</span></div><div>Principales · @(page + 1)/@TvTimeline.PageCount(data) · Actualizado @data.UpdatedAt.ToString("HH:mm:ss")</div></footer>
}
</div>

@code {
    [Parameter] public int Id { get; set; }
    private static readonly CultureInfo Spanish = CultureInfo.GetCultureInfo("es-MX");
    private TvDashboard? data;
    private string? error;
    private bool loading = true;
    private int page, rotation, ticks;
    private DateOnly today = DateOnly.FromDateTime(DateTime.Today);
    private readonly CancellationTokenSource stop = new();
    private Task? timerTask;
    private IJSObjectReference? module;
    private string Deviation => data?.Forecast is DateOnly forecast
        ? (forecast.DayNumber - data.Initiative.TargetDate.DayNumber) switch
        { > 0 and var delta => $"+{delta} días", < 0 and var delta => $"{delta} días", _ => "En fecha" } : "";
    private static string HealthClass(string health) => health switch { "ATRASADO" => "tv-health-late", "EN RIESGO" => "tv-health-risk", "SIN ACTIVIDADES" => "tv-health-empty", _ => "tv-health-ok" };
    protected override async Task OnParametersSetAsync()
    {
        if (data?.Initiative.Id != Id) { data = null; page = 0; rotation = 0; }
        await Refresh();
    }
    protected override Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender) timerTask = RunTimer();
        return Task.CompletedTask;
    }
    private async Task Refresh()
    {
        var id = Id;
        try
        {
            var snapshot = await Service.LoadAsync(id, stop.Token);
            if (Id != id) return;
            today = DateOnly.FromDateTime(DateTime.Today);
            data = snapshot; error = snapshot is null ? "La iniciativa no existe." : null;
            if (data is not null) page %= TvTimeline.PageCount(data);
        }
        catch (OperationCanceledException) when (stop.IsCancellationRequested) { }
        catch (Exception ex) { Logger.LogError(ex, "No se pudo actualizar dashboard {Id}", id); error = "No se pudieron actualizar los datos. Reintentando automáticamente"; }
        finally { loading = false; }
    }
    private async Task RunTimer()
    {
        using var timer = new PeriodicTimer(TimeSpan.FromSeconds(5));
        try
        {
            while (await timer.WaitForNextTickAsync(stop.Token))
                await InvokeAsync(async () =>
                {
                    ticks++;
                    if (ticks % 6 == 0) await Refresh();
                    if (stop.IsCancellationRequested) return;
                    if (ticks % 3 == 0) { rotation++; if (data is not null) page = (page + 1) % TvTimeline.PageCount(data); }
                    StateHasChanged();
                });
        }
        catch (OperationCanceledException) when (stop.IsCancellationRequested) { }
    }
    private async Task Fullscreen()
    {
        module ??= await JS.InvokeAsync<IJSObjectReference>("import", "./tv-dashboard.js");
        await module.InvokeVoidAsync("fullscreen");
    }
    public async ValueTask DisposeAsync()
    {
        await stop.CancelAsync();
        if (timerTask is not null) await timerTask;
        stop.Dispose();
        if (module is not null) { try { await module.DisposeAsync(); } catch (JSDisconnectedException) { } }
    }
}


