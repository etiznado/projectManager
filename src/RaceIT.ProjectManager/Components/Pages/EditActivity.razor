@page "/actividades/{Id:int}/editar"
@attribute [Authorize]
@inject WorkAccess Access
@using Microsoft.EntityFrameworkCore
@using RaceIT.ProjectManager.Data
@using RaceIT.ProjectManager.Domain
@using RaceIT.ProjectManager.Services
@inject IDbContextFactory<ProjectManagerDbContext> DbFactory
@inject ILogger<EditActivity> Logger
@inject NavigationManager Navigation
@inject ActivityPlanningService PlanningService

@if (!IsModal) { <PageTitle>Editar actividad | RaceIT</PageTitle> }
<header class="page-header"><div><span class="eyebrow">RACEIT · PROJECT MANAGER</span><h1 id="activity-edit-title">Editar actividad</h1><p>@projectName</p></div>@if (IsModal) { <button type="button" @onclick="Cancel" disabled="@busy" aria-label="Cerrar edición">✕</button> } else { <a href="/administracion">Volver a administración</a> }</header>
@if (message is not null) { <div class="notice" role="status">@message</div> }
@if (loading) { <p>Cargando actividad...</p> }
else if (input is not null)
{
<div class="edit-grid">
<section class="panel">
<h2>Actividad y avance</h2>
@if (openBlockerCount > 0) { <p class="notice">Esta actividad tiene @openBlockerCount bloqueo(s) abierto(s). Resuélvelos en el panel Bloqueos antes de completarla.</p> }
<EditForm Model="input" OnValidSubmit="Save" FormName="edit-activity" @key="input">
<DataAnnotationsValidator /><ValidationSummary />
<fieldset disabled="@busy">
<label>Nombre<InputText @bind-Value="input.Name" /></label>
@if (isAdmin) { <label>Responsable (opcional)<InputText @bind-Value="input.ResponsibleName" /></label> }
<label>Estado<InputSelect @bind-Value="input.Status"><option value="@ActivityStatus.Pending">Pendiente</option><option value="@ActivityStatus.InProgress">En curso</option><option value="@ActivityStatus.Completed">Completada</option></InputSelect></label>
@if (isAdmin) { <label class="check"><InputCheckbox @bind-Value="input.IsPrincipal" /> Mostrar en el dashboard de TV</label> }
<h3>Pronóstico</h3>
<label>Tipo de duración estimada<InputSelect TValue="DurationType" Value="input.EstimatedDurationType" ValueChanged="ChangeEstimatedType" ValueExpression="() => input.EstimatedDurationType">
<option value="@DurationType.WorkingTime" disabled="@flexibleProject">Horas laborables</option><option value="@DurationType.ElapsedTime">Días naturales (espera / proveedor)</option><option value="@DurationType.ManualDates">Fechas manuales (sin horario)</option>
</InputSelect></label>
<div class="form-row"><label>Inicio solicitado (no antes de)<InputDate @bind-Value="input.EstimatedStart" /></label>@if (input.EstimatedDurationType == DurationType.ManualDates)
{ <label>Fin solicitado (antes de dependencias)<InputDate @bind-Value="input.RequestedFinish" /></label> }
else if (input.EstimatedDurationType == DurationType.ElapsedTime)
{ <label>Duración estimada (días naturales)<InputNumber @bind-Value="input.EstimatedDurationDays" step="0.01" /></label> }
else { <label>Duración estimada (horas laborables)<InputNumber @bind-Value="input.EstimatedDurationHours" step="0.01" /></label> }
</div>
<p class="muted">Los días naturales incluyen fines de semana: 1 día equivale a 24 horas continuas de espera, no de trabajo.</p>
<p class="muted">Pronóstico calculado: <strong>@FinishPreview</strong></p>
<h3>Depende de</h3>
<p class="muted">Esta actividad espera a que terminen todas las seleccionadas. Puedes elegir actividades de otros proyectos de esta iniciativa.</p>
@if (candidates.Count == 0) { <p class="muted">Agrega otras actividades a la iniciativa para vincularlas.</p> }
<div class="dependency-options">
@foreach (var candidate in candidates)
{
    <label class="check"><input type="checkbox" checked="@selectedPredecessors.Contains(candidate.Id)" @onchange="args => TogglePredecessor(candidate.Id, args)" /> <span><strong>@candidate.Project.Name</strong> · @candidate.Name</span></label>
}
</div>
<p class="muted">Las actividades ya iniciadas conservan su inicio real. Una terminada libera a sus sucesoras al día siguiente de su fin real, porque no capturamos la hora real.</p>
<h3>Ejecución real</h3>
<div class="form-row"><label>Inicio real<InputDate @bind-Value="input.ActualStart" /></label><label>Fin real<InputDate @bind-Value="input.ActualFinish" /></label></div>
<p class="muted">En curso requiere inicio real. Completada requiere ambas fechas. Las fechas reales pueden caer en días no laborables.</p>
<div class="form-actions"><button type="submit">@(busy ? "Guardando..." : "Guardar cambios")</button><button type="button" class="secondary" @onclick="Cancel" disabled="@busy">Cancelar</button></div>
</fieldset>
</EditForm>
</section>
<aside class="panel"><h2>Plan original</h2><p class="muted">Se conserva como referencia para medir desviaciones.</p><dl><dt>Inicio planeado</dt><dd>@plannedStart.ToString("dd/MM/yyyy")</dd><dt>Fin planeado</dt><dd>@plannedFinish.ToString("dd/MM/yyyy")</dd><dt>Duración planeada</dt><dd>@WorkCalendarCalculator.DurationText(plannedHours, plannedType)</dd><dt>Calendario</dt><dd>@calendarName</dd></dl></aside>
</div>
}

@code {
    [Parameter] public int Id { get; set; }
    [Parameter] public bool IsModal { get; set; }
    [Parameter] public EventCallback<bool> OnClose { get; set; }
    public async Task Cancel()
    {
        if (busy) return;
        if (IsModal) await OnClose.InvokeAsync(false);
        else Navigation.NavigateTo("/administracion");
    }
    private ActivityEditInput? input;
    private int openBlockerCount;
    private bool loading = true, busy;
    private string? message;
    private string projectName = "", calendarName = "";
    private DateOnly plannedStart, plannedFinish;
    private decimal plannedHours;
    private DurationType plannedType;
    private bool flexibleProject;
    private bool isAdmin;
    private void ChangeEstimatedType(DurationType type)
    {
        if (input is null) return;
        var value = input.EstimatedDurationType == DurationType.ElapsedTime ? input.EstimatedDurationDays : input.EstimatedDurationHours;
        input.EstimatedDurationType = type;
        input.EstimatedDurationHours = type == DurationType.ManualDates ? 0 : type == DurationType.ElapsedTime ? Math.Max(1, value) * 24m : Math.Max(1, value);
        if (type == DurationType.ManualDates) input.RequestedFinish = input.EstimatedStart;
    }
    private Dictionary<DayOfWeek, decimal> days = [];
    private List<ProjectActivity> candidates = [];
    private List<ProjectActivity> previewActivities = [];
    private List<ActivityDependency> previewEdges = [];
    private HashSet<int> selectedPredecessors = [];
    private void TogglePredecessor(int id, ChangeEventArgs args)
    {
        if (args.Value is true) selectedPredecessors.Add(id);
        else selectedPredecessors.Remove(id);
    }
    private string FinishPreview
    {
        get
        {
            if (input is null) return "—";
            try
            {
                var activity = previewActivities.Single(x => x.Id == Id);
                ActivityEditor.Apply(activity, input, days);
                activity.RequestedStart = input.EstimatedStart;
                var edges = previewEdges.Where(x => x.SuccessorId != Id)
                    .Concat(selectedPredecessors.Select(x => new ActivityDependency { PredecessorId = x, SuccessorId = Id })).ToList();
                var forecast = ScheduleCalculator.Calculate(previewActivities, edges)[Id];
                return $"{forecast.Start.Date:dd/MM/yyyy} → {forecast.Finish.Date:dd/MM/yyyy}";
            }
            catch (ArgumentException ex) { return ex.Message; }
        }
    }

    protected override async Task OnParametersSetAsync()
    {
        loading = true; input = null; message = null;
        isAdmin = await Access.IsAdminAsync();
        try
        {
            await using var db = await DbFactory.CreateDbContextAsync();
            var entity = await db.Activities.AsNoTracking().Include(x => x.Responsible)
                .Include(x => x.Project).ThenInclude(x => x.WorkCalendar).ThenInclude(x => x.Days)
                .SingleOrDefaultAsync(x => x.Id == Id);
            if (entity is null) { message = "La actividad no existe."; return; }
            await Access.RequireActivityAsync(entity.ResponsibleId);
            openBlockerCount = await db.Blockers.CountAsync(x => x.ActivityId == Id && x.ResolvedAt == null);
            flexibleProject = entity.Project.WorkCalendar.IsFlexible;
            projectName = entity.Project.Name; calendarName = entity.Project.WorkCalendar.Name;
            plannedStart = entity.PlannedStart; plannedFinish = entity.PlannedFinish; plannedHours = entity.PlannedDurationHours; plannedType = entity.PlannedDurationType;
            days = entity.Project.WorkCalendar.Days.ToDictionary(x => x.DayOfWeek, x => x.WorkingHours);
            previewActivities = await db.Activities.AsNoTracking().Include(x => x.Project).ThenInclude(x => x.WorkCalendar).ThenInclude(x => x.Days)
                .Where(x => x.Project.InitiativeId == entity.Project.InitiativeId).ToListAsync();
            var admin = await Access.IsAdminAsync();
            var personId = await Access.PersonIdAsync();
            candidates = previewActivities.Where(x => x.Id != Id && (admin || x.ResponsibleId == personId)).OrderBy(x => x.Project.Name).ThenBy(x => x.Name).ToList();
            var ids = previewActivities.Select(x => x.Id).ToList();
            previewEdges = await db.ActivityDependencies.AsNoTracking().Where(x => ids.Contains(x.SuccessorId) || ids.Contains(x.PredecessorId)).ToListAsync();
            selectedPredecessors = previewEdges.Where(x => x.SuccessorId == Id).Select(x => x.PredecessorId).ToHashSet();
            input = new ActivityEditInput
            {
                Name = entity.Name, ResponsibleName = entity.Responsible?.Name, Status = entity.Status, IsPrincipal = entity.IsPrincipal,
                RequestedFinish = entity.RequestedFinish, EstimatedStart = entity.RequestedStart, EstimatedDurationHours = entity.EstimatedDurationHours, EstimatedDurationType = entity.EstimatedDurationType,
                ActualStart = entity.ActualStart, ActualFinish = entity.ActualFinish
            };
        }
        catch (Exception ex) { Logger.LogError(ex, "Error al cargar actividad {Id}", Id); message = "No se pudo cargar la actividad. Revisa la conexión e inténtalo de nuevo."; }
        finally { loading = false; }
    }

    private async Task Save()
    {
        if (busy || input is null) return;
        busy = true; message = null;
        try
        {
            await PlanningService.SaveAsync(Id, input, selectedPredecessors.ToArray());
            message = "Cambios guardados. Se recalculó la iniciativa sin cambiar el plan original.";
            if (IsModal) await OnClose.InvokeAsync(true);
        }
        catch (ArgumentException ex) { message = ex.Message; }
        catch (Exception ex) { Logger.LogError(ex, "Error al guardar actividad {Id}", Id); message = "No se pudieron guardar los cambios. Revisa la conexión e inténtalo de nuevo."; }
        finally { busy = false; }
    }
}





