@inherits LayoutComponentBase

<AuthorizeView>
    <Authorized Context="session">
        <header class="app-header">
            <span class="brand">RaceIT · Project Manager</span>
            <nav>
                <a href="/mi-semana">Mi semana</a>
                @if (session.User.IsInRole("Usuario"))
                {
                    <a href="/mis-proyectos">Mis proyectos</a>
                }
                <a href="/initiatives">Initiatives</a>
                @if (session.User.IsInRole("Administrador"))
                {
                    <a href="/administracion">Administración</a>
                }
                <span class="user">@session.User.Identity?.Name</span>
                <form method="post" action="/session/logout" data-enhance="false">
                    <AntiforgeryToken />
                    <button type="submit" class="secondary">Salir</button>
                </form>
            </nav>
        </header>
    </Authorized>
</AuthorizeView>

<main class="app-body">@Body</main>

<div id="blazor-error-ui" data-nosnippet>
    An unhandled error has occurred.
    <a href="." class="reload">Reload</a>
    <span class="dismiss">🗙</span>
</div>
