@inherits LayoutComponentBase
@inject RaceIT.ProjectManager.Services.ThemeState Theme

<AuthorizeView>
    <Authorized Context="session">
        <header class="app-header">
            <span class="brand">RaceIT · Project Manager</span>
            <nav>
                <a href="/mi-semana">Mi semana</a>
                <a href="/frentes-abiertos">Frentes abiertos</a>
                @if (session.User.IsInRole("Usuario"))
                {
                    <a href="/mis-proyectos">Mis proyectos</a>
                }
                <a href="/initiatives">Initiatives</a>
                @if (session.User.IsInRole("Administrador"))
                {
                    <a href="/administracion">Administración</a>
                }
                <button type="button" class="theme-toggle" role="switch" aria-label="Modo oscuro"
                        aria-checked="@(Theme.IsDark ? "true" : "false")"
                        title="@(Theme.IsDark ? "Cambiar a modo claro" : "Cambiar a modo oscuro")" @onclick="Theme.Toggle">
                    <span class="theme-toggle-copy" aria-hidden="true">Modo<span>@(Theme.IsDark ? "oscuro" : "claro")</span></span>
                    <span class="theme-toggle-thumb" aria-hidden="true">
                        @if (Theme.IsDark)
                        {
                            <svg class="theme-toggle-icon" viewBox="0 0 32 32" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                                <path d="M21.5 23.5A11 11 0 0 1 12 5a11 11 0 1 0 14 16 10.9 10.9 0 0 1-4.5 2.5Z" />
                                <path d="m24 5 .8 2.2L27 8l-2.2.8L24 11l-.8-2.2L21 8l2.2-.8Z" fill="currentColor" stroke="none" />
                                <path d="m28 12 .5 1.5L30 14l-1.5.5L28 16l-.5-1.5L26 14l1.5-.5Z" fill="currentColor" stroke="none" />
                            </svg>
                        }
                        else
                        {
                            <svg class="theme-toggle-icon" viewBox="0 0 32 32" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round">
                                <circle cx="16" cy="16" r="6" />
                                <path d="M16 2v4m0 20v4M2 16h4m20 0h4M6.1 6.1l2.8 2.8m14.2 14.2 2.8 2.8M6.1 25.9l2.8-2.8M23.1 8.9l2.8-2.8" />
                            </svg>
                        }
                    </span>
                </button>
                <span class="user">@session.User.Identity?.Name</span>
                <form method="post" action="/session/logout" data-enhance="false">
                    <AntiforgeryToken />
                    <button type="submit" class="secondary">Salir</button>
                </form>
            </nav>
        </header>
    </Authorized>
</AuthorizeView>

<main class="app-body @(Theme.IsDark ? "" : "theme-light")">@Body</main>

<div id="blazor-error-ui" data-nosnippet>
    An unhandled error has occurred.
    <a href="." class="reload">Reload</a>
    <span class="dismiss">🗙</span>
</div>
