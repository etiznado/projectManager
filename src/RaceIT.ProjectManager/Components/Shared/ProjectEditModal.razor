@using Microsoft.EntityFrameworkCore
@using RaceIT.ProjectManager.Data
@using RaceIT.ProjectManager.Domain
@using RaceIT.ProjectManager.Services
@implements IAsyncDisposable
@inject IDbContextFactory<ProjectManagerDbContext> DbFactory
@inject ProjectService Service
@inject IJSRuntime JS
@inject ILogger<ProjectEditModal> Logger

<dialog @ref="dialog" class="activity-modal milestone-modal" aria-labelledby="project-edit-title">
<header class="page-header"><h1 id="project-edit-title">Editar proyecto</h1><button type="button" @onclick="Cancel" disabled="@busy" aria-label="Cerrar edición de proyecto">✕</button></header>
@if (message is not null) { <p class="notice" role="alert">@message</p> }
@if (input is null) { <p>Cargando proyecto...</p> }
else
{
<EditForm Model="input" OnValidSubmit="Save" FormName="edit-project" @key="input">
<DataAnnotationsValidator /><ValidationSummary /><fieldset disabled="@busy">
<label>Nombre<InputText @bind-Value="input.Name" /></label>
<label>Responsable (opcional)<InputText @bind-Value="input.ResponsibleName" /></label>
<label>Calendario<InputSelect @bind-Value="input.WorkCalendarId">@foreach (var calendar in calendars) { <option value="@calendar.Id">@calendar.Name</option> }</InputSelect></label>
<p class="muted">Flexible / sin horario permite trabajar cualquier día con inicio y fin manuales, sin horas semanales. Las esperas del proveedor siguen usando días naturales.</p>
<p class="notice">Cambiar el calendario recalcula el pronóstico de la iniciativa. Al pasar a flexible, las estimaciones laborales se convierten a fechas manuales. El plan original y las fechas reales se conservan. Al volver a un horario, las actividades manuales permanecen manuales hasta que las edites.</p>
<div class="form-actions"><button type="submit">Guardar proyecto</button><button type="button" class="secondary" @onclick="Cancel">Cancelar</button></div>
</fieldset></EditForm>
}
</dialog>

@code {
    [Parameter] public int ProjectId { get; set; }
    [Parameter] public int InitiativeId { get; set; }
    [Parameter] public EventCallback<bool> OnClose { get; set; }
    private ProjectInput? input;
    private List<WorkCalendar> calendars = [];
    private string? message;
    private bool busy;
    private ElementReference dialog;
    private IJSObjectReference? module;
    private DotNetObjectReference<ProjectEditModal>? reference;
    protected override async Task OnInitializedAsync()
    {
        try
        {
            await using var db = await DbFactory.CreateDbContextAsync();
            var project = await db.Projects.AsNoTracking().Include(x => x.Responsible).SingleOrDefaultAsync(x => x.Id == ProjectId && x.InitiativeId == InitiativeId)
                ?? throw new ArgumentException("El proyecto ya no existe en esta iniciativa.");
            calendars = await db.WorkCalendars.AsNoTracking().OrderBy(x => x.Id).ToListAsync();
            input = new() { Name = project.Name, ResponsibleName = project.Responsible?.Name, WorkCalendarId = project.WorkCalendarId };
        }
        catch (Exception ex) { Logger.LogError(ex, "Error al cargar proyecto"); message = "No se pudo cargar el proyecto. Cierra e inténtalo de nuevo."; }
    }
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        module = await JS.InvokeAsync<IJSObjectReference>("import", "./activity-modal.js");
        reference = DotNetObjectReference.Create(this); await module.InvokeVoidAsync("show", dialog, reference);
    }
    [JSInvokable] public async Task RequestClose() => await Cancel();
    private async Task Cancel() { if (!busy) await Close(false); }
    private async Task Close(bool saved)
    {
        if (module is not null) await module.InvokeVoidAsync("close", dialog);
        await OnClose.InvokeAsync(saved);
    }
    private async Task Save()
    {
        if (busy || input is null) return;
        busy = true; message = null;
        try { await Service.SaveAsync(InitiativeId, ProjectId, input); await Close(true); }
        catch (ArgumentException ex) { message = ex.Message; }
        catch (Exception ex) { Logger.LogError(ex, "Error al editar proyecto"); message = "No se pudo guardar el proyecto. Revisa la conexión e inténtalo de nuevo."; }
        finally { busy = false; }
    }
    public async ValueTask DisposeAsync()
    {
        reference?.Dispose();
        if (module is not null) { try { await module.DisposeAsync(); } catch (JSDisconnectedException) { } }
    }
}
